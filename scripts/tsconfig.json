{
  // Editor/typecheck config for Node-run TypeScript scripts (e.g. scripts/sim/*.ts).
  // These run directly with `node file.ts` (native type stripping), so they
  // import local files with explicit `.ts` extensions.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@aweborn/shared/*": ["../shared/*"]
    }
  },
  "include": ["**/*.ts"]
}
